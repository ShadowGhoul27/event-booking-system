PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/event_booking_system
JWT_SECRET=replace_this_with_a_long_random_secret
CLIENT_URL=http://localhost:5173

# The static admin account. It is created (and its password kept in sync) every time the server starts.
ADMIN_EMAIL=admin@evently.local
ADMIN_PASSWORD=change_this_admin_password
ADMIN_NAME=Admin

# Minutes a picked seat or ticket is held while the attendee pays (default 10).
HOLD_MINUTES=10
